{
  "name": "v8-cpu-profile-decoder-mcp",
  "version": "0.2.0",
  "description": "MCP server that decodes V8 CPU profiles into token-efficient bottleneck summaries for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "v8-cpu-profile-decoder-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "test": "vitest run --passWithNoTests",
    "prepack": "chmod +x dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "v8",
    "cpu-profile",
    "performance",
    "profiling",
    "mcp",
    "nodejs",
    "devtools"
  ],
  "author": "vola-trebla",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "source-map": "^0.7.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "**/*.{ts,mjs,json,md}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "mcpName": "io.github.vola-trebla/v8-cpu-profile-decoder-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/vola-trebla/v8-cpu-profile-decoder-mcp.git"
  }
}
